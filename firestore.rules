rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for student records
    match /students/{studentId} {
      // Allow reading, updating, and deleting only if the document belongs to the authenticated user
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      // Allow creation if user is authenticated and sets themselves as the owner
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }
  }
}
